{
  "memwyre": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/inject-memory.js",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/recall-prompt.js",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "memwyre_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/approve-tool.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/capture-session.js",
        "timeout": 30
      }
    ]
  }
}
